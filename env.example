# Twitter API Configuration
# IMPORTANT: These keys should NEVER be exposed to the frontend

# Your TwitterAPI.io API key (backend only)
TWITTER_API_KEY=your_twitter_api_key_here

# OAuth2 Configuration (backend only - NEVER expose to frontend)
TWITTER_CLIENT_SECRET=your_oauth2_client_secret_here

# Frontend OAuth configuration (safe to expose)
NEXT_PUBLIC_TWITTER_CLIENT_ID=your_twitter_oauth_client_id

# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Other configuration
NODE_ENV=development

# Farcaster Manifest (filled by create-onchain --manifest)
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=

# Mini app metadata (optional overrides)
NEXT_PUBLIC_MINIAPP_NAME=EchoCast
NEXT_PUBLIC_MINIAPP_ICON=/icon-192x192.png
NEXT_PUBLIC_MINIAPP_DESCRIPTION=Post to Farcaster and Twitter with Base payments
NEXT_PUBLIC_MINIAPP_SPLASH=/placeholder.jpg
NEXT_PUBLIC_MINIAPP_NOINDEX=true